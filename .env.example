# Copy to .env for local development (never commit .env)
#
# Local options:
#   A) Docker: docker compose up -d
#      then: postgresql://drobe:drobe@localhost:5432/drobebook?schema=public
#   B) Free Neon / Prisma Postgres: paste their connection string
#
# On Railway: do NOT set localhost — use Variable Reference to Postgres DATABASE_URL

# For Prisma temp DB / remote Postgres, keep connection_limit low (e.g. 3–5) to avoid pool timeouts locally.
DATABASE_URL=
# Example query params: ?sslmode=require&connection_limit=3&pool_timeout=30&connect_timeout=30

# Filled automatically by `shopify app dev` — required on Railway manually:
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# Optional: Shopify Function GID for gown-backup-discount (from deploy). Enables auto automatic discount creation on app home load.
# BACKUP_DRESS_FUNCTION_ID=
# SCOPES=write_app_proxy,read_products,write_products,read_orders,write_orders,write_draft_orders,read_customers,write_customers,read_inventory,write_discounts
# SHOPIFY_APP_URL=https://your-app.up.railway.app

# Emails (optional until domain is ready)
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=
# Railway cron — GET /internal/cron/notifications with Authorization: Bearer <secret>
# Optional: GET /internal/cron/backup-dress (reconcile orders + backup variant prices)
CRON_SECRET=

# Optional Slack/email bridge: POST JSON when backup dress order violations are detected
BACKUP_VIOLATION_WEBHOOK_URL=

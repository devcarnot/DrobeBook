# Copy to .env for local development (never commit .env)

# Local Postgres options (pick one):
# A) Docker Desktop: docker compose up -d   then use the URL below
# B) Free Neon/Supabase Postgres: paste their connection string instead
DATABASE_URL="postgresql://drobe:drobe@localhost:5432/drobebook?schema=public"

# Filled automatically by `shopify app dev` — required on Railway manually:
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SCOPES=write_app_proxy,read_products,read_orders,write_orders,write_draft_orders,read_customers,write_customers,read_inventory,write_discounts
# SHOPIFY_APP_URL=https://your-app.up.railway.app

# Emails (optional until domain is ready)
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=

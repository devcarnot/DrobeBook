# Copy to .env for local development (never commit .env)
#
# Local options:
#   A) Docker: docker compose up -d
#      then: postgresql://drobe:drobe@localhost:5432/drobebook?schema=public
#   B) Free Neon / Prisma Postgres: paste their connection string
#
# On Railway: do NOT set localhost — use Variable Reference to Postgres DATABASE_URL

DATABASE_URL=

# Filled automatically by `shopify app dev` — required on Railway manually:
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SCOPES=write_app_proxy,read_products,read_orders,write_orders,write_draft_orders,read_customers,write_customers,read_inventory,write_discounts
# SHOPIFY_APP_URL=https://your-app.up.railway.app

# Emails (optional until domain is ready)
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=

# Railway cron — GET /internal/cron/notifications with Authorization: Bearer <secret>
CRON_SECRET=

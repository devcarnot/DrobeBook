{% assign search_collection = collections[block.settings.collection] %}
{% assign display_mode = block.settings.display_mode | default: 'landing' %}
{% assign results_page = block.settings.results_page | default: '/pages/search-by-date' %}

<div class="gk-drobe-search-section gk-drobe-search-section--full-bleed">
<div
  class="gk-drobe-search"
  data-gk-drobe-search
  data-display-mode="{{ display_mode }}"
  data-results-url="{{ results_page }}"
  data-proxy-base="/apps/gk-drobe"
  data-collection-handle="{{ block.settings.collection | default: 'all' }}"
  data-money-format="{{ shop.money_format | escape }}"
  data-root-url="{{ routes.root_url }}"
  {{ block.shopify_attributes }}
>
  <div class="gk-drobe-search__inner">
    <header class="gk-drobe-search__header">
      <h1 class="gk-drobe-search__title">{{ block.settings.heading | default: 'Search By Date' }}</h1>
    </header>

    {% if display_mode == 'landing' %}
      <div class="gk-drobe-search__form-wrap" data-gk-search-landing>
        <form class="gk-drobe-search__form gk-drobe-search__form--landing" data-gk-search-form>
          <div class="gk-drobe-search__field">
            <label class="gk-drobe-search__label" for="gk-search-event-date">{{ 'search.event_date' | t }}</label>
            <input
              id="gk-search-event-date"
              class="gk-drobe-search__input"
              type="date"
              name="eventDate"
              required
            >
          </div>

          <div class="gk-drobe-search__field">
            <label class="gk-drobe-search__label" for="gk-search-size">{{ 'search.size' | t }}</label>
            <select id="gk-search-size" class="gk-drobe-search__select" name="size" required>
              <option value="">{{ 'search.size_placeholder' | t }}</option>
              {% assign size_values = block.settings.sizes | split: ',' %}
              {% for size in size_values %}
                {% assign trimmed = size | strip %}
                {% if trimmed != blank %}
                  <option value="{{ trimmed }}">{{ trimmed }}</option>
                {% endif %}
              {% endfor %}
            </select>
          </div>

          <div class="gk-drobe-search__field gk-drobe-search__field--action">
            <span class="gk-drobe-search__label gk-drobe-search__label--spacer" aria-hidden="true">&nbsp;</span>
            <button type="submit" class="gk-drobe-search__button">
              {{ block.settings.button_label | default: "Find your dream 'Fit" }}
            </button>
          </div>
        </form>
      </div>
    {% else %}
      <div class="gk-drobe-search__toolbar-wrap" data-gk-search-filters>
        <form class="gk-drobe-search__toolbar gk-drobe-search__toolbar--refine" data-gk-search-form>
          <div class="gk-drobe-search__field">
            <label class="gk-drobe-search__label" for="gk-search-event-date">{{ 'search.event_date' | t }}</label>
            <input
              id="gk-search-event-date"
              class="gk-drobe-search__input"
              type="date"
              name="eventDate"
              required
            >
          </div>

          <div class="gk-drobe-search__field">
            <label class="gk-drobe-search__label" for="gk-search-size">{{ 'search.size' | t }}</label>
            <select id="gk-search-size" class="gk-drobe-search__select" name="size" required>
              <option value="">{{ 'search.size_placeholder' | t }}</option>
              {% assign size_values = block.settings.sizes | split: ',' %}
              {% for size in size_values %}
                {% assign trimmed = size | strip %}
                {% if trimmed != blank %}
                  <option value="{{ trimmed }}">{{ trimmed }}</option>
                {% endif %}
              {% endfor %}
            </select>
          </div>

          <div class="gk-drobe-search__field">
            <label class="gk-drobe-search__label" for="gk-search-duration">{{ 'search.duration' | t }}</label>
            <select id="gk-search-duration" class="gk-drobe-search__select" data-gk-filter-duration>
              <option value="4">4 days</option>
              <option value="8">8 days</option>
            </select>
          </div>

          <div class="gk-drobe-search__field">
            <label class="gk-drobe-search__label" for="gk-search-delivery">{{ 'search.delivery_method' | t }}</label>
            <select id="gk-search-delivery" class="gk-drobe-search__select" data-gk-filter-delivery>
              <option value="post">{{ 'search.post' | t }}</option>
              <option value="pickup">{{ 'search.pickup' | t }}</option>
            </select>
          </div>

          <div class="gk-drobe-search__field">
            <span class="gk-drobe-search__label">{{ 'search.delivery_date' | t }}</span>
            <input class="gk-drobe-search__input gk-drobe-search__input--readonly" type="text" readonly data-gk-filter-delivery-date>
          </div>

          <div class="gk-drobe-search__field">
            <span class="gk-drobe-search__label">{{ 'search.return_date' | t }}</span>
            <input class="gk-drobe-search__input gk-drobe-search__input--readonly" type="text" readonly data-gk-filter-return-date>
          </div>

          <div class="gk-drobe-search__field gk-drobe-search__field--action">
            <span class="gk-drobe-search__label gk-drobe-search__label--spacer" aria-hidden="true">&nbsp;</span>
            <button type="button" class="gk-drobe-search__button" data-gk-refine-search>
              {{ 'search.search_button' | t }}
            </button>
          </div>
        </form>
      </div>

      <div class="gk-drobe-search__results" data-gk-results hidden>
        <div class="gk-drobe-search__layout" data-gk-search-layout>
        <div class="gk-drobe-search__filter-drawer" data-gk-filter-drawer hidden>
          <div
            class="gk-drobe-search__filter-backdrop"
            data-gk-filter-backdrop
            tabindex="-1"
            aria-hidden="true"
          ></div>
          <aside
            id="gk-search-filter-panel-{{ block.id }}"
            class="gk-drobe-search__sidebar gk-drobe-search__filter-panel"
            role="dialog"
            aria-modal="true"
            aria-labelledby="gk-filter-drawer-title-{{ block.id }}"
            aria-hidden="true"
          >
            <div class="gk-drobe-search__filter-panel-header">
              <h2 class="gk-drobe-search__filter-panel-title" id="gk-filter-drawer-title-{{ block.id }}">
                {{ 'search.refine' | t }}
              </h2>
              <button
                type="button"
                class="gk-drobe-search__filter-close"
                data-gk-filters-close
                aria-label="{{ 'search.filters_close' | t }}"
              >
                <span aria-hidden="true">&times;</span>
              </button>
            </div>
            <div class="gk-drobe-search__filter-panel-body">
              <div class="gk-drobe-search__sidebar-group">
                <strong>{{ 'search.sidebar_size' | t }}</strong>
                <div class="gk-drobe-search__checks" data-gk-sidebar-sizes></div>
              </div>
              <div class="gk-drobe-search__sidebar-group">
                <strong>{{ 'search.sidebar_colour' | t }}</strong>
                <div class="gk-drobe-search__checks" data-gk-sidebar-colours></div>
              </div>
              <div class="gk-drobe-search__sidebar-group">
                <strong>{{ 'search.sidebar_designer' | t }}</strong>
                <div class="gk-drobe-search__checks" data-gk-sidebar-designers></div>
              </div>
            </div>
            <div class="gk-drobe-search__filter-panel-footer">
              <p class="gk-drobe-search__filter-panel-count" data-gk-drawer-count></p>
              <button type="button" class="gk-drobe-search__button" data-gk-filters-close>
                {{ 'search.filters_done' | t }}
              </button>
            </div>
          </aside>
        </div>

        <section class="gk-drobe-search__main">
        <div class="gk-drobe-search__facet-bar gk-drobe-search__facet-bar--mobile" data-gk-facet-bar hidden>
          <div class="gk-drobe-search__facet-bar-start">
            <p class="gk-drobe-search__facet-count" data-gk-results-count-mobile></p>
            <button
              type="button"
              class="gk-drobe-search__filters-trigger"
              data-gk-filters-open
              aria-expanded="false"
              aria-controls="gk-search-filter-panel-{{ block.id }}"
            >
              {{ 'search.filters_button' | t }}
            </button>
          </div>
          <div class="gk-drobe-search__facet-bar-end">
            <label class="gk-drobe-search__visually-hidden" for="gk-search-sort-mobile-{{ block.id }}">{{ 'search.sort_label' | t }}</label>
            <select
              id="gk-search-sort-mobile-{{ block.id }}"
              class="gk-drobe-search__select gk-drobe-search__sort gk-drobe-search__sort--mobile"
              data-gk-sort-mobile
            >
              <option value="newest">{{ 'search.sort_newest' | t }}</option>
              <option value="price-asc">{{ 'search.sort_price_low' | t }}</option>
              <option value="price-desc">{{ 'search.sort_price_high' | t }}</option>
            </select>
          </div>
        </div>

          <div class="gk-drobe-search__results-head gk-drobe-search__results-head--desktop">
            <p class="gk-drobe-search__facet-count" data-gk-results-count></p>
            <label class="gk-drobe-search__visually-hidden" for="gk-search-sort-{{ block.id }}">{{ 'search.sort_label' | t }}</label>
            <select
              id="gk-search-sort-{{ block.id }}"
              class="gk-drobe-search__select gk-drobe-search__sort gk-drobe-search__sort--desktop"
              data-gk-sort
            >
              <option value="newest">{{ 'search.sort_newest' | t }}</option>
              <option value="price-asc">{{ 'search.sort_price_low' | t }}</option>
              <option value="price-desc">{{ 'search.sort_price_high' | t }}</option>
            </select>
          </div>
          <div class="gk-drobe-search__loading" data-gk-results-loading hidden>{{ 'search.loading' | t }}</div>
          <div class="gk-drobe-search__grid" data-gk-results-grid></div>
          <p class="gk-drobe-search__empty" data-gk-results-empty hidden>{{ 'search.no_results' | t }}</p>
        </section>
        </div>
      </div>
    {% endif %}

    <p class="gk-drobe-search__error" data-gk-error hidden></p>
  </div>
</div>
</div>

<link rel="stylesheet" href="{{ 'search-by-date.css' | asset_url }}">
<script src="{{ 'gk-theme.js' | asset_url }}" defer></script>
<script src="{{ 'search-by-date.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "GK.Drobe Search By Date",
  "target": "section",
  "settings": [
    {
      "type": "select",
      "id": "display_mode",
      "label": "Display mode",
      "default": "landing",
      "options": [
        {
          "value": "landing",
          "label": "Search form only (redirects to results page)"
        },
        {
          "value": "results",
          "label": "Full search results page"
        }
      ]
    },
    {
      "type": "url",
      "id": "results_page",
      "label": "Results page URL",
      "info": "Where the search form redirects. Create a page (e.g. /pages/search-by-date) and add this block in Full search results page mode."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Page heading",
      "default": "Search By Date"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Search button label",
      "default": "Find your dream 'Fit"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Hire collection"
    },
    {
      "type": "text",
      "id": "sizes",
      "label": "Size options (comma separated)",
      "default": "4,6,8,10,12,14"
    }
  ]
}
{% endschema %}

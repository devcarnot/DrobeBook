{% if product == blank %}
  <div class="gk-drobe-tryon" {{ block.shopify_attributes }}>
    <p>Add this block to a product page to offer try-on appointments for that gown.</p>
  </div>
{% else %}
  {% assign gown_product = product %}
  {% assign gown_variant = gown_product.selected_or_first_available_variant %}

  <div class="gk-drobe-tryon-card" hidden data-gk-tryon-shell>
    <div
      class="gk-drobe-tryon"
      data-gk-drobe-tryon
      data-gown-product-id="{{ gown_product.id }}"
      data-gown-title="{{ gown_product.title | escape }}"
      data-gown-variant-title="{{ gown_variant.title | escape }}"
      data-proxy-base="/apps/gk-drobe"
      {{ block.shopify_attributes }}
    >
      <p class="gk-drobe-tryon__intro" data-gk-intro>{{ block.settings.intro | default: 'Select your appointment time' }}</p>

      <div data-gk-tryon-select-step>
        <div class="gk-drobe-tryon__group">
          <span class="gk-drobe-tryon__label" data-gk-day-type-label>{{ 'try_on.day' | t }}</span>
          <div class="gk-drobe-tryon__buttons" data-gk-day-buttons role="group"></div>
        </div>

        <div class="gk-drobe-tryon__group">
          <span class="gk-drobe-tryon__label" data-gk-duration-type-label>{{ 'try_on.duration' | t }}</span>
          <div class="gk-drobe-tryon__buttons gk-drobe-tryon__buttons--stack" data-gk-duration-buttons role="group"></div>
        </div>

        <div class="gk-drobe-tryon__calendar">
          <div class="gk-drobe-tryon__calendar-header">
            <button type="button" class="gk-drobe-tryon__nav" data-gk-prev-month aria-label="Previous month">&lsaquo;</button>
            <strong data-gk-calendar-label></strong>
            <button type="button" class="gk-drobe-tryon__nav" data-gk-next-month aria-label="Next month">&rsaquo;</button>
          </div>
          <div class="gk-drobe-tryon__loading" data-gk-loading hidden>{{ 'try_on.loading' | t }}</div>
          <div class="gk-drobe-tryon__calendar-grid" data-gk-calendar-grid></div>
        </div>

        <div class="gk-drobe-tryon__group" data-gk-slot-group hidden>
          <label class="gk-drobe-tryon__label" for="gk-tryon-slot-{{ block.id }}" data-gk-time-slot-label>{{ 'try_on.time_slot' | t }}</label>
          <select id="gk-tryon-slot-{{ block.id }}" class="gk-drobe-tryon__select" data-gk-slot-select></select>
        </div>

        <div class="gk-drobe-tryon__price-row">
          <span data-gk-price-label>{{ 'try_on.price' | t }}</span>
          <strong data-gk-price-display>—</strong>
        </div>

        <button type="button" class="gk-drobe-tryon__submit" data-gk-select-time disabled>
          {{ 'try_on.select_time' | t }}
        </button>

        <div class="gk-drobe-tryon__timezone">
          <span data-gk-timezone-label>Brisbane</span>
          <button type="button" class="gk-drobe-tryon__link" data-gk-timezone-change hidden>{{ 'try_on.change_timezone' | t }}</button>
        </div>
      </div>

      <div data-gk-tryon-confirm-step hidden>
        <button type="button" class="gk-drobe-tryon__back" data-gk-back>&larr; {{ 'try_on.back' | t }}</button>
        <p class="gk-drobe-tryon__confirm-title" data-gk-confirm-title>{{ 'try_on.confirm_title' | t }}</p>
        <p class="gk-drobe-tryon__confirm-sub" data-gk-confirm-subtitle>{{ 'try_on.confirm_subtitle' | t }}</p>

        <div class="gk-drobe-tryon__summary-card">
          <div class="gk-drobe-tryon__summary-icon" aria-hidden="true">📅</div>
          <div class="gk-drobe-tryon__summary-copy">
            <strong data-gk-summary-title></strong>
            <p data-gk-summary-datetime></p>
          </div>
          <strong data-gk-summary-price></strong>
        </div>

        <div class="gk-drobe-tryon__group">
          <h4 class="gk-drobe-tryon__section-title" data-gk-additional-info-title>{{ 'try_on.additional_info' | t }}</h4>
          <div class="gk-drobe-tryon__fields">
            <div class="gk-drobe-tryon__field">
              <label class="gk-drobe-tryon__label" for="gk-tryon-event-date-{{ block.id }}" data-gk-event-date-label>{{ 'try_on.event_date' | t }}</label>
              <input id="gk-tryon-event-date-{{ block.id }}" class="gk-drobe-tryon__input" type="date" data-gk-event-date>
            </div>
            <div class="gk-drobe-tryon__field">
              <label class="gk-drobe-tryon__label" for="gk-tryon-items-{{ block.id }}" data-gk-specific-items-label>{{ 'try_on.specific_items' | t }}</label>
              <input id="gk-tryon-items-{{ block.id }}" class="gk-drobe-tryon__input" type="text" placeholder="Style & Size" data-gk-specific-items data-gk-specific-items-placeholder="Style & Size">
            </div>
            <div class="gk-drobe-tryon__field">
              <label class="gk-drobe-tryon__label" for="gk-tryon-instagram-{{ block.id }}" data-gk-instagram-label>{{ 'try_on.instagram' | t }}</label>
              <input id="gk-tryon-instagram-{{ block.id }}" class="gk-drobe-tryon__input" type="text" placeholder="@yourhandle" data-gk-instagram>
            </div>
          </div>
          <p class="gk-drobe-tryon__note" data-gk-availability-note></p>
          <label class="gk-drobe-tryon__checkbox">
            <input type="checkbox" data-gk-availability-check>
            <span data-gk-availability-checkbox-label></span>
          </label>
          <div class="gk-drobe-tryon__terms" data-gk-tryon-terms hidden></div>
        </div>

        <div class="gk-drobe-tryon__price-row">
          <span data-gk-price-label>{{ 'try_on.price' | t }}</span>
          <strong data-gk-confirm-price>—</strong>
        </div>

        <button type="button" class="gk-drobe-tryon__submit gk-drobe-tryon__submit--confirm" data-gk-checkout disabled>
          {{ 'try_on.book_checkout' | t }}
        </button>
      </div>

      <p class="gk-drobe-tryon__error" data-gk-error hidden></p>
    </div>
  </div>

  <script src="{{ 'gk-theme.js' | asset_url }}" defer></script>
{% endif %}

{% schema %}
{
  "name": "GK.Drobe Try-On",
  "target": "section",
  "stylesheet": "try-on-widget.css",
  "javascript": "try-on-widget.js",
  "settings": [
    {
      "type": "text",
      "id": "intro",
      "label": "Intro text",
      "default": "Select your appointment time"
    }
  ]
}
{% endschema %}
